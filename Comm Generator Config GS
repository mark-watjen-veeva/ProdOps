/**
 * FILE: Config.gs
 * LAYER: Configuration
 * PURPOSE: Global sheet name constants and lazy-loaded spreadsheet ID resolver.
 *
 * PHASE 1 NOTES:
 *   - No functional changes from Config_0709. This file was already correct.
 *   - DEFAULT_SPREADSHEET_ID is intentionally mutated at runtime as a
 *     single-execution cache. This is safe in GAS because each execution
 *     starts fresh; the cache only persists within a single server call.
 *   - All other .gs files must call getSpreadsheetId() -- never read
 *     CONFIG.DEFAULT_SPREADSHEET_ID directly.
 */

var CONFIG = {
  TEMPLATES_SHEET: "Email Templates",
  PODS_SHEET: "POD Profiles",
  DEFAULT_SPREADSHEET_ID: ""
};

/**
 * Lazy-loads the spreadsheet ID from Script Properties on first call,
 * then caches it in CONFIG for the remainder of the same execution.
 * @return {string} The target Google Sheets spreadsheet ID.
 */
function getSpreadsheetId() {
  if (CONFIG.DEFAULT_SPREADSHEET_ID) {
    return CONFIG.DEFAULT_SPREADSHEET_ID;
  }
  try {
    var scriptProperties = PropertiesService.getScriptProperties();
    var targetId = scriptProperties.getProperty("CommGenGSheetID");
    if (!targetId) {
      throw new Error("Target Spreadsheet ID (CommGenGSheetID) is missing from Script Properties.");
    }
    CONFIG.DEFAULT_SPREADSHEET_ID = targetId;
    return CONFIG.DEFAULT_SPREADSHEET_ID;
  } catch (err) {
    Logger.log(err.stack);
    throw err;
  }
}
