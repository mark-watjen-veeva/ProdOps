  function executeFormReset() {
    var resetTemplate      = null;
    var resetDowntimeValue = "90 Minutes";
    if (globalTemplatesRegistry && globalTemplatesRegistry.length > 0) {
      document.getElementById('releaseType').value = globalTemplatesRegistry[0].key;
      resetTemplate = globalTemplatesRegistry[0];
      if (resetTemplate && resetTemplate.defaultDowntime) {
        resetDowntimeValue = String(resetTemplate.defaultDowntime).trim();
      }
    }
    document.getElementById('envTheme').value             = "PROD";
    document.getElementById('statusCastType').value       = "Maintenance";
    document.getElementById('releaseVersion').value       = "26R1.0.22";
    document.getElementById('estimatedDowntime').value    = resetDowntimeValue;
    document.getElementById('staggeredWindowHours').value = "0";


    var durationLabel = document.getElementById('estimatedDurationLabel');
    if (durationLabel) {
      var firstKey = resetTemplate ? (resetTemplate.key   || "") : "";
      var firstLbl = resetTemplate ? (resetTemplate.label || "") : "";
      durationLabel.textContent = (/maintenance/i.test(firstKey) || /maintenance/i.test(firstLbl))
        ? "Estimated Duration"
        : "Estimated Vault Downtime";
    }

    var now = new Date();
    var rm  = now.getMonth() + 1;
    var rd  = now.getDate();
    document.getElementById('dateTime').value = now.getFullYear() + "-" + (rm < 10 ? '0' : '') + rm + "-" + (rd < 10 ? '0' : '') + rd + "T10:00";

    activeRegions = []; activeReleases = []; activeProducts = []; activeUpgradeModes = [];
    // P4-04: Clear optional block selection on full form reset.
    activeOptionalBlockKey = '';
    var radioNoneReset = document.getElementById('optBlock_none');
    if (radioNoneReset) radioNoneReset.checked = true;
    var rb1Reset = document.getElementById('optBlock_block1');
    if (rb1Reset) rb1Reset.checked = false;
    var rb2Reset = document.getElementById('optBlock_block2');
    if (rb2Reset) rb2Reset.checked = false;
    regionOnlyModeActive = false;
    var regionToggleReset = document.getElementById('regionOnlyToggle');
    if (regionToggleReset) regionToggleReset.checked = false;
    updateGeneralButtonState();
    [].slice.call(document.querySelectorAll('.macro-filter-btn')).forEach(function(btn) { btn.classList.remove('active'); });
    var masterCheck = document.getElementById('masterSelectAll');
    if (masterCheck) { masterCheck.checked = false; masterCheck.indeterminate = false; }
    [].slice.call(document.querySelectorAll('.pod-box')).forEach(function(cb) { cb.checked = false; });
    document.getElementById('affectedPods').value = "";
    evaluateReleaseTypeContext();
    formatFriendlyDate();
  }

