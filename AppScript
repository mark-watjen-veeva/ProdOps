  // renderChecklistOptions: rebuilds the POD checkbox list from scratch.
  //
  // EARLY POD BEHAVIOUR (P5-01 fix):
  //   Maintenance-only templates (no requiresDowntime):
  //     - Early pods get data-release="General" so the General filter
  //       button selects them automatically.
  //     - The Early filter button is disabled and greyed.
  //     - If "Early" was active in activeReleases it is purged to prevent
  //       ghost-filtering after a template switch.
  //
  //   All other templates (GR/VBV/Classic -- requiresDowntime=true):
  //     - Early pods keep data-release="Early".
  //     - The Early filter button is fully enabled.
  //     - Users can select/deselect Early pods independently.
  //
  // This function is called by:
  //   storeAndInitializeDashboard() -- initial load
  //   evaluateReleaseTypeContext()  -- every template switch
  //   inputVersionOverride()        -- version field changes (cycle affects Early detection)
  function renderChecklistOptions() {
    var container = document.getElementById('podChecklistContainer');
    if (!container) return;
    container.classList.remove('loading-placeholder');

    // PRESERVE SELECTION ACROSS REBUILD: this function replaces the entire
    // checklist's innerHTML below, which would otherwise silently uncheck
    // every already-selected POD (for example on every keystroke in the
    // Release Version field via inputVersionOverride()). Snapshot which
    // POD values are currently checked before the rebuild, then re-apply
    // that selection to the freshly rendered checkboxes afterward.
    var previouslyCheckedPods = {};
    [].slice.call(container.querySelectorAll('.pod-box:checked')).forEach(function(cb) {
      previouslyCheckedPods[cb.value] = true;
    });

    // -- Determine active template type to gate Early merge behaviour. --
    var currentTemplateKey = document.getElementById('releaseType')
      ? document.getElementById('releaseType').value
      : '';
    var activeMatch = globalTemplatesRegistry.find(function(t) {
      return t.key === currentTemplateKey;
    });
    var isMaintenanceOnly = (
      /maintenance/i.test(currentTemplateKey) &&
      !(activeMatch && activeMatch.requiresDowntime)
    );

    // -- Early filter button state: driven by template type. --
    // Must be set BEFORE writing data-release into the DOM so the UI
    // is always consistent with the attribute values rendered below.
    var earlyBtn = document.getElementById('btn-RELEASE-Early');
    if (earlyBtn) {
      if (isMaintenanceOnly) {
        earlyBtn.disabled      = true;
        earlyBtn.title         = 'Early pods are included in General release for this template';
        earlyBtn.style.opacity = '0.4';
        earlyBtn.style.cursor  = 'not-allowed';
        // Purge "Early" from activeReleases to prevent ghost-filtering
        // after switching away from a GR/VBV template where Early was active.
        var earlyIdx = activeReleases.indexOf('Early');
        if (earlyIdx !== -1) {
          activeReleases.splice(earlyIdx, 1);
          earlyBtn.classList.remove('active');
        }
      } else {
        earlyBtn.disabled      = false;
        earlyBtn.title         = '';
        earlyBtn.style.opacity = '1';
        earlyBtn.style.cursor  = 'pointer';
      }
    }

    // -- General button gate: driven by Region Only mode. --
    updateGeneralButtonState();

    // -- R-cycle digit resolution for cycle-specific Early detection. --
    // e.g. "26R1.0.22" -> rNum = "1" -> matches -GR-E1 pods only.
    // Non-cycle Early pods (-GR-E-) always match regardless of version.
    var versionInput = document.getElementById('releaseVersion');
    var versionVal   = versionInput ? versionInput.value : '26R1.0.22';
    var rCycleMatch  = versionVal.match(/R(\d)/i);
    var rNum         = rCycleMatch ? rCycleMatch[1] : null;

    container.innerHTML = globalIndividualPods.map(function(p) {
      var meta    = podMetadataMap[p] || {
        region:      'Unknown',
        release:     'Unknown',
        product:     'Unknown',
        upgradeMode: 'Unknown',
        podGroup:    '',
        regionalSegmentName: ''
      };
      var inputId  = 'chk-' + p;
      var podGroup = meta.podGroup || '';

      // Detect Early pods by their Column B segment name pattern.
      // -GR-E- (no digit) = cycle-agnostic Early (Internal, Agency, etc.)
      // -GR-E1 / -GR-E2 / -GR-E3 = cycle-specific Early pods
      var isEarly = rNum
        ? (new RegExp('-GR-E' + rNum + '\\b', 'i').test(podGroup) || /-GR-E-/i.test(podGroup))
        : /-GR-E/i.test(podGroup);

      // For Maintenance-only: merge Early into General.
      // For all other templates: preserve Early as its own release type.
      var releaseVal;
      if (isEarly && isMaintenanceOnly) {
        releaseVal = 'General';
      } else {
        releaseVal = isEarly ? 'Early' : (meta.release || 'Unknown');
      }

      return '<div class="pod-row-item">'
        + '<input type="checkbox" id="' + inputId + '" class="pod-box" value="' + p + '"'
        + ' data-region="'          + meta.region          + '"'
        + ' data-release="'         + releaseVal           + '"'
        + ' data-product="'         + meta.product         + '"'
        + ' data-upgrade-mode="'    + meta.upgradeMode     + '"'
        + ' data-pod-group="'       + podGroup             + '"'
        + ' data-deployment-time="' + (meta.deploymentTime || '') + '"'
        + ' data-regional-segment-name="' + (meta.regionalSegmentName || '') + '"'
        + ' onchange="calculateMatrixSelections(); updatePreview();">'
        + '<label for="' + inputId + '">' + p + '</label>'
        + '</div>';
    }).join('');

    // Re-apply the pre-rebuild selection snapshot to the newly rendered checkboxes.
    [].slice.call(container.querySelectorAll('.pod-box')).forEach(function(cb) {
      if (previouslyCheckedPods[cb.value]) cb.checked = true;
    });
    updateMasterCheckboxState();

    calculateMatrixSelections();
  }

  function toggleMasterSelectAll(masterCheckbox) {
