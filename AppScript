  function executeMacroSelection(filterType, attributeValue) {
    if (filterType === 'REGION') {
      var idxR = activeRegions.indexOf(attributeValue);
      if (idxR !== -1) { activeRegions.splice(idxR, 1); document.getElementById("btn-REGION-" + attributeValue).classList.remove('active'); }
      else { activeRegions.push(attributeValue); document.getElementById("btn-REGION-" + attributeValue).classList.add('active'); }
    } else if (filterType === 'RELEASE') {
      var idxRl = activeReleases.indexOf(attributeValue);
      if (idxRl !== -1) { activeReleases.splice(idxRl, 1); document.getElementById("btn-RELEASE-" + attributeValue).classList.remove('active'); }
      else { activeReleases.push(attributeValue); document.getElementById("btn-RELEASE-" + attributeValue).classList.add('active'); }
    } else if (filterType === 'PRODUCT') {
      var idxP = activeProducts.indexOf(attributeValue);
      if (idxP !== -1) { activeProducts.splice(idxP, 1); document.getElementById("btn-PRODUCT-" + attributeValue).classList.remove('active'); }
      else { activeProducts.push(attributeValue); document.getElementById("btn-PRODUCT-" + attributeValue).classList.add('active'); }
    } else if (filterType === 'UPGRADEMODE') {
      if (attributeValue === 'Classic') {
        var vbvIdx = activeUpgradeModes.indexOf('VBV');
        if (vbvIdx !== -1) activeUpgradeModes.splice(vbvIdx, 1);
        var vbvBtnEl = document.getElementById('btn-UPGRADEMODE-VBV');
        if (vbvBtnEl) vbvBtnEl.classList.remove('active');
      } else if (attributeValue === 'VBV') {
        var classicIdx = activeUpgradeModes.indexOf('Classic');
        if (classicIdx !== -1) activeUpgradeModes.splice(classicIdx, 1);
        var classicBtnEl = document.getElementById('btn-UPGRADEMODE-Classic');
        if (classicBtnEl) classicBtnEl.classList.remove('active');
      }
      var idxU = activeUpgradeModes.indexOf(attributeValue);
      if (idxU !== -1) {
        activeUpgradeModes.splice(idxU, 1);
        document.getElementById("btn-UPGRADEMODE-" + attributeValue).classList.remove('active');
      } else {
        activeUpgradeModes.push(attributeValue);
        document.getElementById("btn-UPGRADEMODE-" + attributeValue).classList.add('active');
      }
    }

    if (filterType === 'UPGRADEMODE' && activeUpgradeModes.indexOf(attributeValue) !== -1) {
      var downtimeInput = document.getElementById('estimatedDowntime');
      if (downtimeInput) {
        if (attributeValue === 'Classic') downtimeInput.value = "Up to 4 Hours";
        else if (attributeValue === 'VBV') downtimeInput.value = "10 Minutes";
      }
    }

    var boxes = document.querySelectorAll('.pod-box');
    if (activeRegions.length === 0 && activeReleases.length === 0 && activeProducts.length === 0 && activeUpgradeModes.length === 0) {
      boxes.forEach(function(cb) { cb.checked = false; });
      updateMasterCheckboxState();
      calculateMatrixSelections();
      return;
    }

    boxes.forEach(function(cb) {
      var boxUpgradeMode     = cb.getAttribute('data-upgrade-mode') ? cb.getAttribute('data-upgrade-mode').toLowerCase().trim() : "";
      var currentTemplateKey = document.getElementById('releaseType') ? document.getElementById('releaseType').value : "";
      var selectedTemplate   = globalTemplatesRegistry.find(function(t) { return t.key === currentTemplateKey; });
      var isMaintenance      = selectedTemplate ? !selectedTemplate.requiresDowntime : true;
      var matchRegion        = activeRegions.length === 0      || activeRegions.indexOf(cb.getAttribute('data-region')) !== -1;
      var matchRelease       = activeReleases.length === 0     || activeReleases.indexOf(cb.getAttribute('data-release')) !== -1;
      var matchProduct       = activeProducts.length === 0     || activeProducts.indexOf(cb.getAttribute('data-product')) !== -1;
      var matchUpgradeMode   = isMaintenance || activeUpgradeModes.length === 0 || activeUpgradeModes.some(function(mode) { return mode.toLowerCase().trim() === boxUpgradeMode; });

      // REGION ONLY: GR ALWAYS IN, LIMITED/PRERELEASE ONLY WHEN EXPLICITLY
      // SELECTED. Once Region Only mode is forced on, General Release
      // ("GR") PODs are routed entirely through the Regional Segment Name
      // when the POD is Vault (see submitData() / processPushRequest --
      // that path is Vault-gated via isVaultRegionalPod()) and are always
      // pulled in by region/product/upgrade-mode alone -- release-type
      // filters never exclude them. This auto-check convenience test below
      // is deliberately GR-only and product-agnostic, NOT the same gate as
      // the Vault-only SendGrid segment targeting: it only decides which
      // PODs get swept into the checklist by clicking Region/Product alone.
      // Gating it on Vault as well would mean clicking a non-Vault Product
      // button (LIMS/RegOne/Safety) alone never auto-populates any PODs,
      // since an explicit Release filter would then always be required too.
      // Limited / Prerelease / Early PODs are the opposite: they must NOT
      // be swept in just because no release-type filter happens to be
      // active (the normal "empty activeReleases = match everyone" shortcut
      // is intentionally disabled for them here) -- the user has to
      // explicitly click +Limited / +Prerelease / +Early to include them.
      // Every other template keeps the original behavior untouched in the
      // else branch below.
      if (regionOnlyModeActive) {
        var isGrPod = /GR/i.test(cb.getAttribute('data-pod-group') || '');
        var matchReleaseExplicit = activeReleases.length > 0 && activeReleases.indexOf(cb.getAttribute('data-release')) !== -1;
        cb.checked = isGrPod
          ? (matchRegion && matchProduct && matchUpgradeMode)
          : (matchRegion && matchProduct && matchUpgradeMode && matchReleaseExplicit);
      } else {
        cb.checked = matchRegion && matchRelease && matchProduct && matchUpgradeMode;
      }
    });
    updateMasterCheckboxState();
    calculateMatrixSelections();

    // PHASE 5 FIX: Product filter buttons previously only updated the
    // checklist/live preview, leaving the Subject Line field stale (it was
    // only rebuilt on template switch via evaluateReleaseTypeContext() or on
    // a Release Version edit via inputVersionOverride()). This caused the
    // reported "Subject is not in alignment" bug: clicking +Safety updated
    // the title/body/What-line via [[PRODUCT]] token resolution, but the
    // Subject Line input kept showing the old product. Reusing
    // inputVersionOverride() here (rather than duplicating subject-assembly
    // logic) preserves any manually-typed subject text -- it only strips and
    // reapplies the trailing version suffix and re-resolves [[PRODUCT]] --
    // which respects WORK PRESERVATION. Applies uniformly to every template,
    // not just Maintenance Only, per confirmed scope.
    if (filterType === 'PRODUCT') {
      inputVersionOverride();
    }
  }

  // -------------------------------------------------------------------
  // MATRIX / AFFECTED PODS COMPILATION
  // -------------------------------------------------------------------
  function calculateMatrixSelections() {
    var textArea = document.getElementById('affectedPods');
    if (!textArea) return;

    var checkedBoxes = [].slice.call(document.querySelectorAll('.pod-box:checked'));
    updateMasterCheckboxState();

    if (checkedBoxes.length === 0) { textArea.value = ""; debouncedPreview(); return; }

    var regionalNestedMap = {};
    checkedBoxes.forEach(function(cb) {
      var podName = cb.value;
      var region  = cb.getAttribute('data-region')  || 'Unknown';
      var release = cb.getAttribute('data-release') || 'Release';
      if (!regionalNestedMap[region])               regionalNestedMap[region] = {};
      if (!regionalNestedMap[region][release])      regionalNestedMap[region][release] = {};
      if (!regionalNestedMap[region][release].pods) regionalNestedMap[region][release].pods = [];
      regionalNestedMap[region][release].pods.push(podName);
    });

    var rawDate        = getSafeValue('dateTime', '');
    var staggeredHours = getSafeValue('staggeredWindowHours', '0');

    var ptStaggeredText   = "";
    var apacPtLink        = "";
    var jstStaggeredText  = "";
    var euPtLink          = "";
    var cestStaggeredText = "";

    if (rawDate && Number(staggeredHours) > 0) {
      var parts = rawDate.split(/[-T:]/);
      if (parts.length >= 5) {
        var yr = parseInt(parts[0], 10);
        var mo = parseInt(parts[1], 10) - 1;
        var dy = parseInt(parts[2], 10);
        var hr = parseInt(parts[3], 10);
        var mn = parseInt(parts[4], 10);

        var baseDate = new Date(Date.UTC(yr, mo, dy, hr, mn));
        var endDate  = new Date(baseDate.getTime() + (Number(staggeredHours) * 60 * 60 * 1000));

        function cleanTimeStr(dateObj, timeZone) {
          var opts      = { hour: 'numeric', minute: '2-digit', hour12: true, timeZone: timeZone };
          var partsArr  = new Intl.DateTimeFormat('en-US', opts).formatToParts(dateObj);
          var hVal      = partsArr.find(function(p) { return p.type === 'hour'; }).value;
          var mVal      = partsArr.find(function(p) { return p.type === 'minute'; }).value;
          var dayPeriod = partsArr.find(function(p) { return p.type === 'dayPeriod'; }).value.toLowerCase();
          if (mVal === "00") {
            if (hVal === "12" && dayPeriod === "pm") return "noon";
            if (hVal === "12" && dayPeriod === "am") return "midnight";
          }
          return hVal + ":" + mVal + " " + dayPeriod;
        }

        var baseDayUS   = new Intl.DateTimeFormat('en-US', { day: 'numeric', weekday: 'long', month: 'long', timeZone: 'America/Los_Angeles' }).format(baseDate);
        var baseDayEU   = new Intl.DateTimeFormat('en-US', { day: 'numeric', weekday: 'long', month: 'long', timeZone: 'Europe/Paris' }).format(baseDate);
        var baseDayJST  = new Intl.DateTimeFormat('en-US', { day: 'numeric', weekday: 'long', month: 'long', timeZone: 'Asia/Tokyo' }).format(baseDate);
        var endDayJST   = new Intl.DateTimeFormat('en-US', { day: 'numeric', timeZone: 'Asia/Tokyo' }).format(endDate);
        var jstDayContext = baseDayJST;
        if (baseDayJST.split(' ').pop() !== endDayJST) { jstDayContext = baseDayJST + " into Friday"; }

        var worldClockUrl = "https://www.timeanddate.com/worldclock/fixedtime.html?p1=5402&iso=" + rawDate.replace(/[-:]/g, "") + "&sort=1";

        ptStaggeredText   = ' <a href="' + worldClockUrl + '" clicktracking="off" target="_blank" style="color: #007bff; text-decoration: none;">US between ' + cleanTimeStr(baseDate, 'America/Los_Angeles') + ' and ' + cleanTimeStr(endDate, 'America/Los_Angeles') + ' PDT</a> (' + baseDayUS + ')';
        apacPtLink        = ' <a href="' + worldClockUrl + '" clicktracking="off" target="_blank" style="color: #007bff; text-decoration: none;">APAC between ' + cleanTimeStr(baseDate, 'America/Los_Angeles') + ' and ' + cleanTimeStr(endDate, 'America/Los_Angeles') + ' PDT</a>';
        jstStaggeredText  = ' (' + jstDayContext + ' between ' + cleanTimeStr(baseDate, 'Asia/Tokyo') + ' and ' + cleanTimeStr(endDate, 'Asia/Tokyo') + ' JST)';
        euPtLink          = ' <a href="' + worldClockUrl + '" clicktracking="off" target="_blank" style="color: #007bff; text-decoration: none;">EU between ' + cleanTimeStr(baseDate, 'America/Los_Angeles') + ' and ' + cleanTimeStr(endDate, 'America/Los_Angeles') + ' PDT</a>';
        cestStaggeredText = ' (' + baseDayEU + ' between ' + cleanTimeStr(baseDate, 'Europe/Paris') + ' and ' + cleanTimeStr(endDate, 'Europe/Paris') + ' CEST)';
      }
    }
/////////////////////////////////////////////

    var activeProductFilters = [];
    ['Vault','LIMS','RegOne','Safety'].forEach(function(prod) {
      var btn = document.getElementById('btn-PRODUCT-' + prod);
      if (btn && btn.classList.contains('active')) activeProductFilters.push(prod);
    });
    if (activeProductFilters.length === 0) activeProductFilters.push('Vault');

    var targetRegionOrder     = ["US", "EU", "APAC"];
    var compiledLines         = [];
    var currentTemplateKey    = document.getElementById('releaseType') ? document.getElementById('releaseType').value : "";
    var selectedTemplate      = globalTemplatesRegistry.find(function(t) { return t.key === currentTemplateKey; });
    var isMaintenanceTemplate = selectedTemplate ? !selectedTemplate.requiresDowntime : true;

    if (isMaintenanceTemplate) {
      targetRegionOrder.forEach(function(regKey) {
        if (!regionalNestedMap[regKey]) return;
        Object.keys(regionalNestedMap[regKey]).sort().forEach(function(releaseTypeTag) {
          var sortedPodNames    = regionalNestedMap[regKey][releaseTypeTag].pods.sort(naturalSort);
          var displayReleaseTag = releaseTypeTag;
          if (displayReleaseTag.toLowerCase().indexOf("release") === -1) displayReleaseTag = displayReleaseTag + " Release";
          compiledLines.push("<u>" + regKey + " " + displayReleaseTag + ":</u> " + sortedPodNames.join(', '));
        });
      });
      Object.keys(regionalNestedMap).forEach(function(regKey) {
        if (targetRegionOrder.indexOf(regKey) !== -1) return;
        Object.keys(regionalNestedMap[regKey]).sort().forEach(function(releaseTypeTag) {
          var sortedPodNames    = regionalNestedMap[regKey][releaseTypeTag].pods.sort(naturalSort);
          var displayReleaseTag = releaseTypeTag;
          if (displayReleaseTag.toLowerCase().indexOf("release") === -1) displayReleaseTag = displayReleaseTag + " Release";
          compiledLines.push("<u>" + regKey + " " + displayReleaseTag + ":</u> " + sortedPodNames.join(', '));
        });
      });

    } else {
      var isVbvTemplate = /vbv/i.test(currentTemplateKey);

      if (isVbvTemplate) {
        var checkedBoxes2 = [].slice.call(document.querySelectorAll('.pod-box:checked'));

        function parseFormattedTime(timeStr) {
          if (!timeStr) return null;
          var match = timeStr.match(/(\d{1,2}):(\d{2})\s*(AM|PM)/i);
          if (!match) return null;
          var h      = parseInt(match[1], 10);
          var m      = parseInt(match[2], 10);
          var period = match[3].toUpperCase();
          if (period === 'PM' && h !== 12) h += 12;
          if (period === 'AM' && h === 12) h = 0;
          var tzSuffix = timeStr.replace(/.*?(AM|PM)/i, '').trim() || 'PDT';
          return { hours: h, minutes: m, tzSuffix: tzSuffix };
        }

        function vbvFmtTime(d, tz) {
          var opts   = { hour: 'numeric', minute: '2-digit', hour12: true, timeZone: tz };
          var parts2 = new Intl.DateTimeFormat('en-US', opts).formatToParts(d);
          var hv     = parts2.find(function(p) { return p.type === 'hour'; }).value;
          var mv     = parts2.find(function(p) { return p.type === 'minute'; }).value;
          var dp     = parts2.find(function(p) { return p.type === 'dayPeriod'; }).value.toLowerCase();
          if (mv === '00' && hv === '12' && dp === 'pm') return 'noon';
          if (mv === '00' && hv === '12' && dp === 'am') return 'midnight';
          return hv + ':' + mv + ' ' + dp;
        }

        function vbvGetPtAbbr(utcMs) {
          var nameParts = new Intl.DateTimeFormat('en-US', {
            timeZone: 'America/Los_Angeles', timeZoneName: 'long'
          }).formatToParts(new Date(utcMs));
          var longName = '';
          for (var ni = 0; ni < nameParts.length; ni++) {
            if (nameParts[ni].type === 'timeZoneName') longName = nameParts[ni].value;
          }
          return (longName.toLowerCase().indexOf('daylight') !== -1 ||
                  longName.toLowerCase().indexOf('summer')   !== -1) ? 'PDT' : 'PST';
        }

        function buildVbvPdtWindow(startTimeStr, staggerHours, releaseDateStr) {
          var parsed = parseFormattedTime(startTimeStr);
          if (!parsed) return startTimeStr;
          var dateParts  = releaseDateStr ? releaseDateStr.split(/[-T:]/) : [];
          var yr2        = dateParts.length >= 3 ? parseInt(dateParts[0], 10) : new Date().getFullYear();
          var mo2        = dateParts.length >= 3 ? parseInt(dateParts[1], 10) - 1 : new Date().getMonth();
          var dy2        = dateParts.length >= 3 ? parseInt(dateParts[2], 10) : new Date().getDate();
          var startUtcMs = resolvePacificUtcMs(yr2, mo2, dy2, parsed.hours, parsed.minutes);
          var startDate2 = new Date(startUtcMs);
          var endDate2   = new Date(startUtcMs + (Number(staggerHours) * 60 * 60 * 1000));
          var ptAbbr     = vbvGetPtAbbr(startUtcMs);
          var startStr2  = vbvFmtTime(startDate2, 'America/Los_Angeles');
          var endStr2    = vbvFmtTime(endDate2,   'America/Los_Angeles');
          var startDay2  = new Intl.DateTimeFormat('en-US', { day: 'numeric', month: 'long', timeZone: 'America/Los_Angeles' }).format(startDate2);
          var endDay2    = new Intl.DateTimeFormat('en-US', { day: 'numeric', month: 'long', timeZone: 'America/Los_Angeles' }).format(endDate2);
          if (Number(staggerHours) > 0) {
            if (startDay2 !== endDay2) {
              return 'between ' + startStr2 + ' and ' + endStr2 + ' ' + ptAbbr + ' (' + endDay2 + ')';
            }
            return 'between ' + startStr2 + ' and ' + endStr2 + ' ' + ptAbbr;
          }
          return startStr2 + ' ' + ptAbbr;
        }

        function buildVbvRegionalParenthetical(startTimeStr, staggerHours, releaseDateStr, region) {
          if (region === 'US') return '';
          var parsed = parseFormattedTime(startTimeStr);
          if (!parsed) return '';
          var dateParts  = releaseDateStr ? releaseDateStr.split(/[-T:]/) : [];
          var yr2        = dateParts.length >= 3 ? parseInt(dateParts[0], 10) : new Date().getFullYear();
          var mo2        = dateParts.length >= 3 ? parseInt(dateParts[1], 10) - 1 : new Date().getMonth();
          var dy2        = dateParts.length >= 3 ? parseInt(dateParts[2], 10) : new Date().getDate();
          var startUtcMs = resolvePacificUtcMs(yr2, mo2, dy2, parsed.hours, parsed.minutes);
          var startDate2 = new Date(startUtcMs);
          var endDate2   = new Date(startUtcMs + (Number(staggerHours) * 60 * 60 * 1000));

          if (region === 'APAC') {
            var jstStart   = vbvFmtTime(startDate2, 'Asia/Tokyo');
            var jstEnd     = vbvFmtTime(endDate2,   'Asia/Tokyo');
            var jstMonth   = new Intl.DateTimeFormat('en-US', { month: 'long',    timeZone: 'Asia/Tokyo' }).format(startDate2);
            var jstDay     = new Intl.DateTimeFormat('en-US', { day:   'numeric', timeZone: 'Asia/Tokyo' }).format(startDate2);
            var jstEndDay  = new Intl.DateTimeFormat('en-US', { day:   'numeric', timeZone: 'Asia/Tokyo' }).format(endDate2);
            var jstLabel   = jstMonth + ' ' + jstDay;
            if (jstDay !== jstEndDay) {
              var jstEndMonth = new Intl.DateTimeFormat('en-US', { month: 'long', timeZone: 'Asia/Tokyo' }).format(endDate2);
              jstLabel = jstMonth + ' ' + jstDay + ' into ' + jstEndMonth + ' ' + jstEndDay;
            }
            if (Number(staggerHours) > 0) {
              return ' (' + jstLabel + ', between ' + jstStart + ' and ' + jstEnd + ' JST)';
            }
            return ' (' + jstLabel + ' at ' + jstStart + ' JST)';
          }

          if (region === 'EU') {
            var cestStart  = vbvFmtTime(startDate2, 'Europe/Paris');
            var cestEnd    = vbvFmtTime(endDate2,   'Europe/Paris');
            var cestMonth  = new Intl.DateTimeFormat('en-US', { month: 'long',    timeZone: 'Europe/Paris' }).format(startDate2);
            var cestDay    = new Intl.DateTimeFormat('en-US', { day:   'numeric', timeZone: 'Europe/Paris' }).format(startDate2);
            var cestEndDay = new Intl.DateTimeFormat('en-US', { day:   'numeric', timeZone: 'Europe/Paris' }).format(endDate2);
            var cestLabel  = cestMonth + ' ' + cestDay;
            if (cestDay !== cestEndDay) {
              var cestEndMonth = new Intl.DateTimeFormat('en-US', { month: 'long', timeZone: 'Europe/Paris' }).format(endDate2);
              cestLabel = cestMonth + ' ' + cestDay + ' into ' + cestEndMonth + ' ' + cestEndDay;
            }
            if (Number(staggerHours) > 0) {
              return ' (' + cestLabel + ', between ' + cestStart + ' and ' + cestEnd + ' CEST)';
            }
            return ' (' + cestLabel + ' at ' + cestStart + ' CEST)';
          }

          return '';
        }

        function buildWorldClockUrl(startTimeStr, releaseDateStr, staggerHours) {
          var parsed    = parseFormattedTime(startTimeStr);
          if (!parsed) return '';
          var dateParts = releaseDateStr ? releaseDateStr.split(/[-T:]/) : [];
          var yr2       = dateParts.length >= 3 ? parseInt(dateParts[0], 10) : new Date().getFullYear();
          var mo2       = dateParts.length >= 3 ? parseInt(dateParts[1], 10) - 1 : new Date().getMonth();
          var dy2       = dateParts.length >= 3 ? parseInt(dateParts[2], 10) : new Date().getDate();
          var isoYr     = String(yr2);
          var isoMo     = (mo2 + 1 < 10 ? '0' : '') + (mo2 + 1);
          var isoDy     = (dy2 < 10 ? '0' : '') + dy2;
          var isoHr     = (parsed.hours < 10 ? '0' : '') + parsed.hours;
          var isoMin    = (parsed.minutes < 10 ? '0' : '') + parsed.minutes;
          var ahParam   = (Number(staggerHours) > 0) ? '&ah=' + Number(staggerHours) : '';
          return 'https://www.timeanddate.com/worldclock/fixedtime.html?p1=5402&iso=' + isoYr + isoMo + isoDy + 'T' + isoHr + isoMin + ahParam + '&sort=1';
        }

        var deployTimeGroups = {};
        checkedBoxes2.forEach(function(cb) {
          var dt      = cb.getAttribute('data-deployment-time') || '';
          var region  = cb.getAttribute('data-region') || 'US';
          var timeKey = dt.trim() || '__global__';
          if (!deployTimeGroups[timeKey])         deployTimeGroups[timeKey] = {};
          if (!deployTimeGroups[timeKey][region]) deployTimeGroups[timeKey][region] = [];
          deployTimeGroups[timeKey][region].push(cb.value);
        });

        var sortedGroupKeys = Object.keys(deployTimeGroups).sort(function(a, b) {
          if (a === '__global__') return 1;
          if (b === '__global__') return -1;
          var pa = parseFormattedTime(a);
          var pb = parseFormattedTime(b);
          if (!pa) return 1;
          if (!pb) return -1;
          return (pa.hours * 60 + pa.minutes) - (pb.hours * 60 + pb.minutes);
        });

        var regionOrder = ['US', 'EU', 'APAC'];
        var vbvLines    = [];

        sortedGroupKeys.forEach(function(timeKey) {
          var regionMap = deployTimeGroups[timeKey];

          var regionsInSlot = Object.keys(regionMap).sort(function(a, b) {
            var ia = regionOrder.indexOf(a); var ib = regionOrder.indexOf(b);
            if (ia === -1) ia = 999; if (ib === -1) ib = 999;
            return ia - ib;
          });

          regionsInSlot.forEach(function(region) {
            var sortedPods   = regionMap[region].slice().sort(naturalSort);
            var linkedWindow = '';

            if (timeKey === '__global__') {
              if (region === 'US')   linkedWindow = ptStaggeredText   || '';
              if (region === 'EU')   linkedWindow = euPtLink + cestStaggeredText;
              if (region === 'APAC') linkedWindow = apacPtLink + jstStaggeredText;
            } else {
              var pdtWindowText = buildVbvPdtWindow(timeKey, staggeredHours, rawDate);
              var clockUrl      = buildWorldClockUrl(timeKey, rawDate, staggeredHours);
              var regionalParen = buildVbvRegionalParenthetical(timeKey, staggeredHours, rawDate, region);
              linkedWindow = ' <a href="' + clockUrl
                + '" clicktracking="off" target="_blank"'
                + ' style="color: #007bff; text-decoration: none;">'
                + pdtWindowText + '</a>' + regionalParen;
            }

            vbvLines.push(
              '<u><strong>' + region + '</strong></u>'
              + linkedWindow + ':  '
              + sortedPods.join(', ')
            );
          });
        });

        var hrSep = '\n<div style="margin-top: 4px;"></div>\n';
        compiledLines.push(vbvLines.join(hrSep));

      } else {

        // Classic downtime path
        var classicBaseUtcMs = 0;
        if (rawDate) {
          var cdp = rawDate.split(/[-T:]/);
          if (cdp.length >= 5) {
            classicBaseUtcMs = resolvePacificUtcMs(
              parseInt(cdp[0],10),
              parseInt(cdp[1],10) - 1,
              parseInt(cdp[2],10),
              parseInt(cdp[3],10),
              parseInt(cdp[4],10)
            );
          }
        }

        var classicWorldClockUrl = rawDate
          ? 'https://www.timeanddate.com/worldclock/fixedtime.html?p1=5402&iso=' + rawDate.replace(/[-:]/g, '') + '&sort=1'
          : '';

        function classicFmtTime(utcMs, timeZone) {
          var parts = new Intl.DateTimeFormat('en-US', { hour: 'numeric', minute: '2-digit', hour12: true, timeZone: timeZone }).formatToParts(new Date(utcMs));
          var hv = ''; var mv = ''; var dp = '';
          for (var ci = 0; ci < parts.length; ci++) {
            if (parts[ci].type === 'hour')      hv = parts[ci].value;
            if (parts[ci].type === 'minute')    mv = parts[ci].value;
            if (parts[ci].type === 'dayPeriod') dp = parts[ci].value.toLowerCase();
          }
          if (mv === '00' && hv === '12' && dp === 'pm') return 'noon';
          if (mv === '00' && hv === '12' && dp === 'am') return 'midnight';
          return hv + ':' + mv + ' ' + dp;
        }

        function classicGetTzAbbr(utcMs, timeZone) {
          if (timeZone === 'Asia/Tokyo') return 'JST';
          var nameParts = new Intl.DateTimeFormat('en-US', { timeZone: timeZone, timeZoneName: 'long' }).formatToParts(new Date(utcMs));
          var longName  = '';
          for (var ni = 0; ni < nameParts.length; ni++) {
            if (nameParts[ni].type === 'timeZoneName') longName = nameParts[ni].value;
          }
          if (timeZone === 'America/Los_Angeles') return (longName.toLowerCase().indexOf('daylight') !== -1 || longName.toLowerCase().indexOf('summer') !== -1) ? 'PDT' : 'PST';
          if (timeZone === 'Europe/Paris')        return (longName.toLowerCase().indexOf('summer')   !== -1 || longName.toLowerCase().indexOf('daylight') !== -1) ? 'CEST' : 'CET';
          return '';
        }

        function classicJstCrossesDay(utcMs) {
          var ptDay  = new Intl.DateTimeFormat('en-US', { day: 'numeric', timeZone: 'America/Los_Angeles' }).format(new Date(utcMs));
          var jstDay = new Intl.DateTimeFormat('en-US', { day: 'numeric', timeZone: 'Asia/Tokyo' }).format(new Date(utcMs));
          return ptDay !== jstDay;
        }

        function classicJstFullLabel(utcMs) {
          var d       = new Date(utcMs);
          var weekday = new Intl.DateTimeFormat('en-US', { weekday: 'long',    timeZone: 'Asia/Tokyo' }).format(d);
          var month   = new Intl.DateTimeFormat('en-US', { month:   'long',    timeZone: 'Asia/Tokyo' }).format(d);
          var day     = new Intl.DateTimeFormat('en-US', { day:     'numeric', timeZone: 'Asia/Tokyo' }).format(d);
          return weekday + ', ' + month + ' ' + day + ' at ' + classicFmtTime(utcMs, 'Asia/Tokyo') + ' JST';
        }

        var classicLines = [];

        targetRegionOrder.forEach(function(regKey) {
          if (!regionalNestedMap[regKey]) return;

          Object.keys(regionalNestedMap[regKey]).sort().forEach(function(releaseTypeTag) {
            var regionPods = [];
            [].slice.call(document.querySelectorAll('.pod-box:checked')).forEach(function(cb) {
              var boxRegion  = cb.getAttribute('data-region');
              var boxRelease = cb.getAttribute('data-release');
              if (boxRegion === regKey && boxRelease === releaseTypeTag) {
                if (regionPods.indexOf(cb.value) === -1) regionPods.push(cb.value);
              }
            });
            if (regionPods.length === 0) return;

            var sortedPods = regionPods.sort(naturalSort);

            var ptStr = classicBaseUtcMs
              ? classicFmtTime(classicBaseUtcMs, 'America/Los_Angeles') + ' ' + classicGetTzAbbr(classicBaseUtcMs, 'America/Los_Angeles')
              : '';
            var parenthetical = '';
            if (regKey === 'EU' && classicBaseUtcMs) {
              parenthetical = ' (' + classicFmtTime(classicBaseUtcMs, 'Europe/Paris') + ' ' + classicGetTzAbbr(classicBaseUtcMs, 'Europe/Paris') + ')';
            } else if (regKey === 'APAC' && classicBaseUtcMs) {
              parenthetical = ' (' + classicFmtTime(classicBaseUtcMs, 'Asia/Tokyo') + ' JST)';
            }

            var timeAnchor = '';
            if (classicBaseUtcMs && classicWorldClockUrl) {
              if (regKey === 'EU') {
                var euRegionalStr   = classicFmtTime(classicBaseUtcMs, 'Europe/Paris') + ' ' + classicGetTzAbbr(classicBaseUtcMs, 'Europe/Paris');
                var euRegionalParen = ' (' + euRegionalStr + ')';
                timeAnchor = ' <a href="' + classicWorldClockUrl + '" clicktracking="off" target="_blank" style="color: #007bff; text-decoration: none;">' + ptStr + '</a>' + euRegionalParen;
              } else if (regKey === 'APAC') {
                var apacRegionalStr   = classicFmtTime(classicBaseUtcMs, 'Asia/Tokyo') + ' JST';
                var apacRegionalParen = ' (' + apacRegionalStr + ')';
                timeAnchor = ' <a href="' + classicWorldClockUrl + '" clicktracking="off" target="_blank" style="color: #007bff; text-decoration: none;">' + ptStr + '</a>' + apacRegionalParen;
              } else {
                timeAnchor = ' <a href="' + classicWorldClockUrl + '" clicktracking="off" target="_blank" style="color: #007bff; text-decoration: none;">' + ptStr + '</a>';
              }
            } else if (ptStr) {
              timeAnchor = ' ' + ptStr + parenthetical;
            } else {
              timeAnchor = ':';
            }
            classicLines.push('<u><strong>' + regKey + '</strong></u>' + timeAnchor + ':  ' + sortedPods.join(', '));
          });
        });

        // NEW: fallback for any region value outside US/EU/APAC (e.g. "Unknown"
        // for PODs whose metadata hasn't been mapped to this release cycle yet).
        // Without this, those PODs were silently dropped from the Classic/downtime
        // path even though the Maintenance path already handles this case via its
        // own second loop above. Mirrors that same pattern for the Classic branch.
        Object.keys(regionalNestedMap).forEach(function(regKey) {
          if (targetRegionOrder.indexOf(regKey) !== -1) return;

          Object.keys(regionalNestedMap[regKey]).sort().forEach(function(releaseTypeTag) {
            var regionPods = [];
            [].slice.call(document.querySelectorAll('.pod-box:checked')).forEach(function(cb) {
              var boxRegion  = cb.getAttribute('data-region');
              var boxRelease = cb.getAttribute('data-release');
              if (boxRegion === regKey && boxRelease === releaseTypeTag) {
                if (regionPods.indexOf(cb.value) === -1) regionPods.push(cb.value);
              }
            });
            if (regionPods.length === 0) return;

            var sortedPods = regionPods.sort(naturalSort);
            var ptStrFallback = classicBaseUtcMs
              ? classicFmtTime(classicBaseUtcMs, 'America/Los_Angeles') + ' ' + classicGetTzAbbr(classicBaseUtcMs, 'America/Los_Angeles')
              : '';
            var timeAnchorFallback = (classicBaseUtcMs && classicWorldClockUrl)
              ? ' <a href="' + classicWorldClockUrl + '" clicktracking="off" target="_blank" style="color: #007bff; text-decoration: none;">' + ptStrFallback + '</a>'
              : (ptStrFallback ? ' ' + ptStrFallback : ':');
            classicLines.push('<u><strong>' + regKey + '</strong></u>' + timeAnchorFallback + ':  ' + sortedPods.join(', '));
          });
        });

        var hrSep2 = '\n<div style="margin-top: 4px;"></div>\n';
        compiledLines.push(classicLines.join(hrSep2));

      }     // closes: else (Classic path, not VBV)
    }       // closes: else (isMaintenanceTemplate false)

    textArea.value = isMaintenanceTemplate ? compiledLines.join('\n\n') : (compiledLines[0] || "");
    debouncedPreview();
  }

