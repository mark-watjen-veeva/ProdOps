      })()
    };

    if (targetPlatform === 'SendGrid') {
      var sgBtn = document.getElementById('submitActionBtn');
      if (sgBtn) { sgBtn.innerText = "Processing Request..."; sgBtn.disabled = true; }

      if (regionOnlyModeActive) {
        // REGION ONLY MODE -- hybrid targeting (PHASE 4 FIX: Region + Vault
        // gate, Column B fallback). Confirmed use case: "If Region is
        // selected and Product = Vault, then SendGrid Segment IDs = Col L,
        // else SendGrid Segment ID = Col B."
        //   PODs that pass isVaultRegionalPod() (a Region filter is active
        //     AND Product = Vault AND Column B matches the "Vault-GR"
        //     pattern): contribute their Column L (Regional Segment Name)
        //     value to regionNamesObj. If that specific POD has NO Column L
        //     value entered despite qualifying, it does not drop silently --
        //     it falls back to its own individual Column B pod-group name
        //     instead, same as the path below.
        //   Every other checked POD (no Region filter active, OR Product is
        //     not Vault, OR Column B doesn't match "Vault-GR") always
        //     resolves via its own individual Column B pod-group name --
        //     this is the "else Col B" half of the use case.
        // Both sets are resolved independently and unioned into one
        // segment_ids array server-side (see processPushRequest).
        // Classifying checked PODs by Column B (data-pod-group) also lets
        // the guard below tell "expected -- nothing selected" apart from
        // "unexpected -- PODs selected but still nothing resolvable on
        // either path".
        var regionNamesObj       = {};
        var fallbackPodGroupsObj = {};
        var checkedGrCount       = 0;
        var checkedNonGrCount    = 0;
        [].slice.call(document.querySelectorAll('.pod-box:checked')).forEach(function(cb) {
          var pg = cb.getAttribute('data-pod-group') || '';
          if (isVaultRegionalPod(cb)) {
            checkedGrCount++;
            var rname = cb.getAttribute('data-regional-segment-name');
            if (rname && rname.trim() !== "") {
              regionNamesObj[rname.trim()] = true;
            } else if (pg && pg !== "No Match Found" && pg !== "Unmapped") {
              // Qualifying Vault-GR POD with no Column L value entered --
              // fall back to its own Column B segment name rather than
              // dropping it from the send entirely.
              fallbackPodGroupsObj[pg.trim()] = true;
            }
          } else {
            checkedNonGrCount++;
            if (pg && pg !== "No Match Found" && pg !== "Unmapped") fallbackPodGroupsObj[pg.trim()] = true;
          }
        });

        // GUARD: Region Only is on, but nothing was collected on either
        // path. Sending two empty arrays here silently produces a
        // zero-recipient draft, so block it client-side instead of letting
        // it reach SendGrid. With the Column B fallback above, this now
        // only fires when a checked POD's Column B value is ALSO
        // "Unmapped" / "No Match Found" (true zero-recipient case) -- it no
        // longer fires merely because Column L was left blank.
        if (Object.keys(regionNamesObj).length === 0 && Object.keys(fallbackPodGroupsObj).length === 0) {
          var alertMsg;
          if (checkedGrCount === 0 && checkedNonGrCount === 0) {
            alertMsg = "Region Only is enabled, but no PODs are selected.\n\n"
              + "This draft was NOT submitted -- select at least one POD, or uncheck Region Only.";
          } else {
            // Only reachable when every checked POD's Column B value is
            // itself "Unmapped" / "No Match Found" -- genuinely unexpected,
            // since any POD with a usable Column B value now always
            // resolves through the fallback above.
            alertMsg = "Region Only is enabled, and " + (checkedGrCount + checkedNonGrCount) + " POD(s) are selected, but none of them have a usable Regional Segment Name (Column L) or SendGrid Segment Name (Column B).\n\n"
              + "This draft was NOT submitted -- sending now would create a SendGrid campaign with zero recipients.\n\n"
              + "Check POD Profiles Column L and Column B for the selected PODs.";
          }
          alert(alertMsg);
          if (sgBtn) { sgBtn.innerText = "Create SendGrid Draft"; sgBtn.disabled = false; }
          return;
        }

        formDataPayload.regionOnlyMode       = true;
        formDataPayload.regionalSegmentNames = Object.keys(regionNamesObj);
        formDataPayload.selectedPodGroups    = Object.keys(fallbackPodGroupsObj);
      } else {
        var podGroupsObj = {};
        [].slice.call(document.querySelectorAll('.pod-box:checked')).forEach(function(cb) {
          var pg = cb.getAttribute('data-pod-group');
          if (pg && pg !== "No Match Found" && pg !== "Unmapped") podGroupsObj[pg.trim()] = true;
        });
        formDataPayload.regionOnlyMode    = false;
        formDataPayload.selectedPodGroups = Object.keys(podGroupsObj);
      }

      google.script.run
        .withSuccessHandler(function(res) {
          if (res && res.status === 'error') {
            var alertText = "API Rejection:\n\n" + res.message;
            if (res.segmentDiagnostic && res.segmentDiagnostic.length > 0) {
              alertText += "\n\n--- Active SendGrid Segments (" + res.segmentDiagnostic.length + " / 10 max) ---\n";
              res.segmentDiagnostic.forEach(function(seg, idx) {
                alertText += (idx + 1) + ". [" + seg.id + "]  " + seg.name + "\n";
              });
              if (res.segmentDiagnostic.length >= 10) {
                alertText += "\nWARNING: Segment quota at limit. Delete unused segments in SendGrid before retrying.";
              }
            }
            alert(alertText);
            if (sgBtn) { sgBtn.innerText = "Create SendGrid Draft"; sgBtn.disabled = false; }
          } else {
            // Informational only -- only ever present when a non-blank
            // segment name (Column B or Column L) was submitted but did not
            // match a live SendGrid segment. Never fires for blank/unmapped
            // values, so this stays silent during normal partial rollout.
            if (res && res.unmatchedSegmentNames && res.unmatchedSegmentNames.length > 0) {
              alert("SendGrid Draft Created, but the following segment name(s) did not match any live SendGrid segment and were skipped:\n\n"
                + res.unmatchedSegmentNames.join("\n")
                + "\n\nCheck for a typo, or a segment that was renamed/deleted in SendGrid.");
            }
            if (sgBtn) {
              sgBtn.classList.add('success-state'); sgBtn.innerText = "SendGrid Draft Created!"; sgBtn.disabled = false;
              setTimeout(function() { sgBtn.classList.remove('success-state'); sgBtn.innerText = "Create SendGrid Draft"; }, 3500);
            }
          }
        })
        .withFailureHandler(function(err) {
          alert("SendGrid Network Error: " + err.toString());
          if (sgBtn) { sgBtn.innerText = "Create SendGrid Draft"; sgBtn.disabled = false; }
        })
        .processPushRequest(formDataPayload);
    } else {
      var scBtn = document.getElementById('trustActionBtn');
      if (scBtn) { scBtn.innerText = "Pushing to StatusCast..."; scBtn.disabled = true; }
      google.script.run
        .withSuccessHandler(function(res) {
          if (res && res.status === 'error') {
            alert("API Rejection:\n\n" + res.message);
            if (scBtn) { scBtn.innerText = "Create Trust Draft"; scBtn.disabled = false; }
          } else {
            if (scBtn) {
              scBtn.classList.add('success-state'); scBtn.innerText = "StatusCast Draft Created!"; scBtn.disabled = false;
              setTimeout(function() { scBtn.classList.remove('success-state'); scBtn.innerText = "Create Trust Draft"; }, 3500);
            }
          }
        })
        .withFailureHandler(function(err) {
          alert("StatusCast Network Error: " + err.toString());
          if (scBtn) { scBtn.innerText = "Create Trust Draft"; scBtn.disabled = false; }
        })
        .processTrustPushRequest(formDataPayload);
    }
  }

  // -------------------------------------------------------------------
  // TAB SWITCHING
  // Manages three tabs: comm-gen, template-ed, global-settings.
  // All views and links are reset to inactive first, then the target
  // tab is activated. This pattern makes adding future tabs trivial --
  // just extend the allViews / allLinks arrays and add a new branch.
  // -------------------------------------------------------------------
  function switchAppTab(targetId) {
    var allViews = [
      document.getElementById('view-comm-gen'),
      document.getElementById('view-template-ed'),
      document.getElementById('view-global-settings')
    ];
    var allLinks = [
      document.getElementById('link-comm-gen'),
      document.getElementById('link-template-ed'),
      document.getElementById('link-global-settings')
    ];

    allViews.forEach(function(v) { if (v) v.style.display = 'none'; });
    allLinks.forEach(function(l) {
      if (l) { l.style.color = '#4a5568'; l.style.borderBottomColor = 'transparent'; }
    });

    if (targetId === 'comm-gen') {
      var commView = document.getElementById('view-comm-gen');
      var commLink = document.getElementById('link-comm-gen');
      if (commView) commView.style.display = 'flex';
      if (commLink) { commLink.style.color = '#1a73e8'; commLink.style.borderBottomColor = '#1a73e8'; }

    } else if (targetId === 'template-ed') {
      var tmplView = document.getElementById('view-template-ed');
      var tmplLink = document.getElementById('link-template-ed');
      if (tmplView) tmplView.style.display = 'flex';
      if (tmplLink) { tmplLink.style.color = '#1a73e8'; tmplLink.style.borderBottomColor = '#1a73e8'; }
      syncEditorTemplateDropdown();

    } else if (targetId === 'global-settings') {
      var gsView = document.getElementById('view-global-settings');
      var gsLink = document.getElementById('link-global-settings');
      if (gsView) gsView.style.display = 'flex';
      if (gsLink) { gsLink.style.color = '#1a73e8'; gsLink.style.borderBottomColor = '#1a73e8'; }
      loadGlobalSettingsToForm();
    }
  }

