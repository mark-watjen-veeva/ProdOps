  // -------------------------------------------------------------------
  function insertTable(editorId, rows, cols) {
    var el = document.getElementById(editorId);
    if (!el) return;
    el.focus();
    rows = rows || 2;
    cols = cols || 2;
    var tableHtml = '<table style="border-collapse: collapse; width: 100%; margin: 8px 0;">';
    for (var r = 0; r < rows; r++) {
      tableHtml += '<tr>';
      for (var c = 0; c < cols; c++) {
        tableHtml += '<td style="border: 1px solid #cbd5e1; padding: 6px 10px;'
          + ' font-family: Arial, sans-serif; font-size: 13px; min-width: 60px;">'
          + '&nbsp;</td>';
      }
      tableHtml += '</tr>';
    }
    tableHtml += '</table><br/>';
    document.execCommand('insertHTML', false, tableHtml);
  }

