      version:              getSafeValue('releaseVersion', ''),
      friendlyDate:         getSafeValue('friendlyDate', ''),
      targetDateIso:        getSafeValue('isoStringValue', ''),
      isoString:            getSafeValue('isoStringValue', ''),
      rawDateValue:         getSafeValue('dateTime', ''),
      affectedPods:         getSafeValue('affectedPods', ''),
     notesUrl:             resolveActiveNotesUrl(activeMatch),
      whatsNewUrl:          activeMatch ? (activeMatch.whatsNewUrl || '') : '',
      customNotesText:      getSafeValue('emailNotes', ''),
