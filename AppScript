  function openLinkModal(editorId) {
    var sel = window.getSelection();

    if (sel && sel.rangeCount > 0) {
      _savedRange        = sel.getRangeAt(0).cloneRange();
      _savedSelectedText = sel.toString();
    } else {
      _savedRange        = null;
      _savedSelectedText = "";
    }

    _activeEditorTarget = editorId;

    document.getElementById('modalLinkLabel').value = _savedSelectedText;
    document.getElementById('modalLinkUrl').value   = '';
    document.getElementById('editorLinkModal').classList.add('open');
    setTimeout(function() { document.getElementById('modalLinkUrl').focus(); }, 50);
  }

  function closeLinkModal() {
    document.getElementById('editorLinkModal').classList.remove('open');
    _savedRange         = null;
    _savedSelectedText  = "";
    _activeEditorTarget = null;
  }

  function confirmInsertLink() {
    var label = document.getElementById('modalLinkLabel').value.trim();
    var url   = document.getElementById('modalLinkUrl').value.trim();
    if (!url)   { alert('A URL is required.'); return; }
    if (!label) { label = url; }

    var targetEditorId = _activeEditorTarget;
    var savedRange     = _savedRange;

    closeLinkModal();

    if (!targetEditorId) return;

    var el = document.getElementById(targetEditorId);
    if (!el) return;

    var linkNode           = document.createElement('a');
    linkNode.href          = url;
    linkNode.target        = '_blank';
    linkNode.setAttribute('clicktracking', 'off');
    linkNode.style.cssText = 'color: #007bff; text-decoration: none;';
    linkNode.textContent   = label;

    el.focus();

    if (savedRange) {
      var sel = window.getSelection();
      sel.removeAllRanges();
      sel.addRange(savedRange);

      savedRange.deleteContents();
      savedRange.insertNode(linkNode);

      var newRange = document.createRange();
      newRange.setStartAfter(linkNode);
      newRange.collapse(true);
      sel.removeAllRanges();
      sel.addRange(newRange);
    } else {
      var linkHtml = '<a href="' + url + '" clicktracking="off" target="_blank"'
        + ' style="color: #007bff; text-decoration: none;">' + label + '</a>';
      document.execCommand('insertHTML', false, linkHtml);
    }
  }
</script>
