  function updateMasterCheckboxState() {
    var totalBoxes   = document.querySelectorAll('.pod-box').length;
    var checkedBoxes = document.querySelectorAll('.pod-box:checked').length;
    var master       = document.getElementById('masterSelectAll');
    if (master) {
      master.checked       = (totalBoxes === checkedBoxes && totalBoxes > 0);
      master.indeterminate = (checkedBoxes > 0 && checkedBoxes < totalBoxes);
    }
