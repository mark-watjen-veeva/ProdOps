  // storeAndInitializeDashboard: builds filter buttons then renders the
  // checklist. Early button enabled/disabled state is managed entirely
  // inside renderChecklistOptions(), which is template-aware. Do NOT
  // disable the Early button here -- it must stay live for GR/VBV/Classic.
  function storeAndInitializeDashboard(response) {
    if (!response || response.status !== 'success') return;
    globalIndividualPods = response.individualPods || [];
    podMetadataMap       = response.podMetadata    || {};
    var cleanRegions     = (response.uniqueRegions || []).filter(function(r) { return r !== 'NA'; });
    var uniqueReleases   = (response.uniqueReleases || []).concat(['Early']);
    buildFilterButtons('regionButtonCluster',  cleanRegions,   'REGION');
    buildFilterButtons('releaseButtonCluster', uniqueReleases, 'RELEASE');
    buildFilterButtons('productButtonCluster', response.uniqueProducts || [], 'PRODUCT');
    renderChecklistOptions();
