      var activeMatch        = globalTemplatesRegistry.find(function(t) { return t.key === releaseTypeValue; });
      var isDowntimeRequired = activeMatch ? (activeMatch.requiresDowntime === true) : false;

      console.log('[updatePreview] htmlUpper length:', activeMatch ? (activeMatch.htmlUpper || '').length : 'NO MATCH');
      console.log('[updatePreview] affectedPods length:', getSafeValue('affectedPods','').length);

      var formDataPayload = {
        envTheme:             getSafeValue('envTheme', 'PROD'),
        version:              getSafeValue('releaseVersion', '26R1.0.22'),
        friendlyDate:         getSafeValue('friendlyDate', 'Wednesday, April 29 at 10:00 am PDT'),
        targetDateIso:        getSafeValue('isoStringValue', '20260429T1000'),
        isoString:            getSafeValue('isoStringValue', '20260429T1000'),
        rawDateValue:         getSafeValue('dateTime', ''),
        templateKey:          releaseTypeValue,
        requiresDowntime:     isDowntimeRequired,
        estimatedDowntime:    (isDowntimeRequired || /maintenance/i.test(releaseTypeValue)) ? getSafeValue('estimatedDowntime', '90 Minutes') : "",
        staggeredWindowHours: isDowntimeRequired ? Number(getSafeValue('staggeredWindowHours', '0')) : 0,
        emailTitle:           getSafeValue('emailTitle', ''),
        product:              resolveActiveProductToken(),
        notesUrl:             resolveActiveNotesUrl(activeMatch),
        whatsNewUrl:          activeMatch ? (activeMatch.whatsNewUrl || '') : '',
        customNotesText:      getSafeValue('emailNotes', ''),
        affectedPods:         getSafeValue('affectedPods', ''),
        htmlUpper:            activeMatch ? (activeMatch.htmlUpper || '') : '',
        htmlLower:            activeMatch ? (activeMatch.htmlLower || '') : '',
        // P4-04: Resolve optional block HTML for maintenance templates.
        // Uses explicit key comparison to avoid || short-circuit producing wrong block
        // when block1Html is an empty string (falsy). Each key maps to exactly one source.
        activeOptionalBlockHtml: (function() {
          var isMaintOnly = /maintenance/i.test(releaseTypeValue) && !(activeMatch && activeMatch.requiresDowntime);
          if (!isMaintOnly || !activeOptionalBlockKey) return '';
          if (activeOptionalBlockKey === 'block1') return activeMatch ? (activeMatch.optionalBlock1Html || '') : '';
          if (activeOptionalBlockKey === 'block2') return activeMatch ? (activeMatch.optionalBlock2Html || '') : '';
          return '';
        })()
      };

      if (typeof google !== 'undefined' && google.script && google.script.run) {
        google.script.run
          .withSuccessHandler(function(html) {
            viewport.innerHTML = html || '<div style="color:red;padding:20px;">Server returned empty response</div>';
          })
          .withFailureHandler(function(err) {
            console.error('[generateMasterHtmlLayout FAILED]', err.message || err);
            viewport.innerHTML = '<div style="color:red;padding:20px;">Server error: ' + (err.message || err) + '</div>';
          })
          .generateMasterHtmlLayout(formDataPayload);
      }
    } catch (e) { console.error(e); }
  }

