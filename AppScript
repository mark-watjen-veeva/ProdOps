  function loadTemplateToEditorForm() {
    var selectKey    = document.getElementById('editorTemplateSelect').value;
    var deleteBtn    = document.getElementById('deleteTemplateBtn');
    var typeSelector = document.getElementById('ed_templateType');
    var saveBtn      = document.getElementById('saveTemplateBtn');

    if (!selectKey) {
      ['ed_key','ed_label','ed_subject','ed_title','ed_notesUrl','ed_whatsNewUrl','ed_defaultVersion'].forEach(function(id) {
        var el = document.getElementById(id);
        if (el) el.value = '';
      });
      setEditorContent('ed_upper_editor', '');
      setEditorContent('ed_lower_editor', '');
      setEditorContent('ed_optBlock1_editor', '');
      setEditorContent('ed_optBlock2_editor', '');
      var ob1LblEl = document.getElementById('ed_optBlock1Label');
      var ob2LblEl = document.getElementById('ed_optBlock2Label');
      if (ob1LblEl) ob1LblEl.value = '';
      if (ob2LblEl) ob2LblEl.value = '';
      var regionChkReset = document.getElementById('ed_allowsRegionSegment');
      if (regionChkReset) regionChkReset.checked = false;
      typeSelector.value = 'Maintenance';
      document.getElementById('ed_staggeredHours').value  = '0';
      document.getElementById('ed_defaultDowntime').value = '90 Minutes';
      toggleEditorTypeFields('Maintenance');
      if (deleteBtn) deleteBtn.style.display = 'none';
      if (saveBtn)   saveBtn.innerHTML = '&#128190; Save as New Template Reference';
      return;
    }

    var match = globalTemplatesRegistry.find(function(t) { return t.key === selectKey; });
    if (!match) return;

    document.getElementById('ed_key').value            = match.key;
    document.getElementById('ed_label').value          = match.label || match.key;
    document.getElementById('ed_subject').value        = match.subject || match.Default_Subject || '';
    document.getElementById('ed_title').value          = match.title  || match.Default_Title   || '';
    document.getElementById('ed_notesUrl').value       = match.notesUrl || 'https://vaulthelp.veeva.com';
    document.getElementById('ed_whatsNewUrl').value    = match.whatsNewUrl || '';
    document.getElementById('ed_defaultVersion').value = match.defaultVersion || '';
    setEditorContent('ed_upper_editor', match.htmlUpper || '');
    setEditorContent('ed_lower_editor', match.htmlLower || '');
    setEditorContent('ed_optBlock1_editor', match.optionalBlock1Html || '');
    setEditorContent('ed_optBlock2_editor', match.optionalBlock2Html || '');
    var ob1LblLoad = document.getElementById('ed_optBlock1Label');
    var ob2LblLoad = document.getElementById('ed_optBlock2Label');
    if (ob1LblLoad) ob1LblLoad.value = match.optionalBlock1Label || '';
    if (ob2LblLoad) ob2LblLoad.value = match.optionalBlock2Label || '';
    var regionChkLoad = document.getElementById('ed_allowsRegionSegment');
    if (regionChkLoad) regionChkLoad.checked = (match.allowsRegionSegment === true);

    var deducedType = (match.requiresDowntime === true) ? 'Downtime' : 'Maintenance';
    typeSelector.value = deducedType;
    document.getElementById('ed_staggeredHours').value  = match.staggeredWindowHours || 0;
    document.getElementById('ed_defaultDowntime').value = match.defaultDowntime || '90 Minutes';
    toggleEditorTypeFields(deducedType);

    if (deleteBtn) deleteBtn.style.display = 'block';
    if (saveBtn)   saveBtn.innerHTML = '&#128221; Overwrite Existing Template Settings';
  }

  function toggleEditorTypeFields(selectedType) {
    var downtimeBlock   = document.getElementById('ed_downtime_fields');
    var whatsNewBlock   = document.getElementById('ed_whatsNewUrlWrapper');
    var optBlockMeta    = document.getElementById('ed_optionalBlockSection');
    var optBlockEditors = document.getElementById('ed_optionalBlockSection_editors');

    if (downtimeBlock)    downtimeBlock.style.display    = (selectedType === 'Downtime')    ? 'flex' : 'none';
    if (whatsNewBlock)    whatsNewBlock.style.display    = (selectedType === 'Downtime')    ? 'flex' : 'none';
    if (optBlockMeta)     optBlockMeta.style.display     = (selectedType === 'Maintenance') ? 'flex' : 'none';
    if (optBlockEditors)  optBlockEditors.style.display  = (selectedType === 'Maintenance') ? 'flex' : 'none';

    if (selectedType !== 'Downtime') {
      var ddField = document.getElementById('ed_defaultDowntime');
      if (ddField) ddField.value = '90 Minutes';
      var shField = document.getElementById('ed_staggeredHours');
      if (shField) shField.value = '0';
      var wnField = document.getElementById('ed_whatsNewUrl');
      if (wnField) wnField.value = '';
    }
  }

  function submitTemplateConfigToServer() {
    var saveBtn     = document.getElementById('saveTemplateBtn');
    var targetKey   = document.getElementById('ed_key').value;
    var targetLabel = document.getElementById('ed_label').value;

function stripRenderedLinks(html) {
  return html
    // FIX: was [\w\d]+, which matched ANY preceding word -- including
    // "Developer Release Notes" -- and would silently rewrite that link to
    // point at the generic notesUrl on next save. Now requires the prefix to
    // start with a digit (version-shaped, e.g. "26R3"), so "Developer Release
    // Notes" is left alone.
    .replace(/<a[^>]*href="[^"]*"[^>]*>\s*\d[\w.]*\s*Release Notes\s*<\/a>/gi, '[[VERSION]] Release Notes')
    .replace(/<a[^>]*href="[^"]*"[^>]*>\s*Release Notes\s*<\/a>/gi, '[[RELEASE_NOTES_URL]]')
    .replace(/<a[^>]*href="[^"]*vaultpod[^"]*"[^>]*>\s*here\s*<\/a>/gi, '[[LOCATION_TAG]]')
    .replace(/<a[^>]*href="[^"]*trust\.veeva\.com[^"]*"[^>]*>\s*Veeva Trust Site\s*<\/a>/gi, 'Veeva Trust Site')
    .replace(/<a[^>]*href="[^"]*support\.veeva\.com[^"]*"[^>]*>\s*Veeva Product Support\s*<\/a>/gi, 'Veeva Product Support');
}

    var payload = {
      key:                  targetKey,
      label:                targetLabel,
      templateType:         document.getElementById('ed_templateType').value,
      subject:              document.getElementById('ed_subject').value,
      title:                document.getElementById('ed_title').value,
      staggeredWindowHours: document.getElementById('ed_staggeredHours').value,
      defaultDowntime:      document.getElementById('ed_defaultDowntime').value || '90 Minutes',
      defaultVersion:       document.getElementById('ed_defaultVersion') ? document.getElementById('ed_defaultVersion').value.trim() : '',
      notesUrl:             document.getElementById('ed_notesUrl').value,
      whatsNewUrl:          document.getElementById('ed_whatsNewUrl').value.trim(),
      htmlUpper:            getEditorContent('ed_upper_editor'),
      htmlLower:            stripRenderedLinks(getEditorContent('ed_lower_editor')),
      optionalBlock1Html:   getEditorContent('ed_optBlock1_editor'),
      optionalBlock2Html:   getEditorContent('ed_optBlock2_editor'),
      optionalBlock1Label:  (document.getElementById('ed_optBlock1Label') ? document.getElementById('ed_optBlock1Label').value.trim() : ''),
      optionalBlock2Label:  (document.getElementById('ed_optBlock2Label') ? document.getElementById('ed_optBlock2Label').value.trim() : ''),
      allowsRegionSegment:  (document.getElementById('ed_allowsRegionSegment') ? document.getElementById('ed_allowsRegionSegment').checked : false)
    };

    if (!payload.label.trim()) { alert('Validation failure: Template Name is required.'); return; }
    if (targetKey) {
      if (!confirm("Are you sure you want to overwrite the existing settings for '" + targetLabel + "'?")) return;
    }

    saveBtn.innerText = 'Processing Write Execution...';
    saveBtn.disabled  = true;

    google.script.run
      .withSuccessHandler(function(res) {
        if (res && res.status === 'error') {
          alert(res.message);
          saveBtn.innerHTML = targetKey ? '&#128221; Overwrite Existing Template Settings' : '&#128190; Save as New Template Reference';
          saveBtn.disabled  = false;
        } else {
          alert('Configuration saved successfully!');
          saveBtn.disabled = false;
          refreshAppConfigurations();
        }
      })
      .withFailureHandler(function(err) {
        alert('Network error: ' + err.toString());
        saveBtn.innerHTML = targetKey ? '&#128221; Overwrite Existing Template Settings' : '&#128190; Save as New Template Reference';
        saveBtn.disabled  = false;
      })
      .saveSpreadsheetTemplate(payload);
  }

  function refreshAppConfigurations() {
    var currentActiveKey = document.getElementById('ed_key').value;
    google.script.run
      .withSuccessHandler(function(response) {
        populateDynamicTemplatesDropdown(response);
        syncEditorTemplateDropdown();
        if (currentActiveKey) {
          var editorSelector = document.getElementById('editorTemplateSelect');
          if (editorSelector) editorSelector.value = currentActiveKey;
        }
        loadTemplateToEditorForm();
      })
      .getSpreadsheetTemplatesConfig();
  }

