  function restoreEditorSelection() {
    if (!_savedRange || !_activeEditorTarget) return;
    var el = document.getElementById(_activeEditorTarget);
    if (!el) return;
    el.focus();
    var sel = window.getSelection();
    if (sel) { sel.removeAllRanges(); sel.addRange(_savedRange); }
