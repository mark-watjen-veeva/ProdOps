  function syncEditorTemplateDropdown() {
    var editorSelector = document.getElementById('editorTemplateSelect');
    if (!editorSelector || !globalTemplatesRegistry) return;
    editorSelector.innerHTML = '<option value="">-- Add New Template Reference --</option>'
      + globalTemplatesRegistry.map(function(t) {
