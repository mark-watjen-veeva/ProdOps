  // -------------------------------------------------------------------
  function applyFontSize(editorId, sizeValue) {
    if (!sizeValue) return;
    var el = document.getElementById(editorId);
    if (!el) return;
    el.focus();
    var sel = window.getSelection();
    if (!sel || sel.rangeCount === 0) return;
    var selectedText = sel.toString();
    if (selectedText.length > 0) {
      document.execCommand(
        'insertHTML', false,
        '<span style="font-size: ' + sizeValue + ';">' + selectedText + '</span>'
      );
    } else {
      document.execCommand(
        'insertHTML', false,
        '<span style="font-size: ' + sizeValue + ';">&#8203;</span>'
      );
    }
  }

  // -------------------------------------------------------------------
  // CLEAR FORMATTING
  // -------------------------------------------------------------------
  function clearEditorFormatting(editorId) {
    var el = document.getElementById(editorId);
    if (!el) return;
    el.focus();
    var sel = window.getSelection();
    if (!sel || sel.rangeCount === 0) return;
    if (sel.toString().length === 0) return;

    document.execCommand('removeFormat', false, null);

    var range    = sel.getRangeAt(0);
    var fragment = range.cloneContents();
    var tempDiv  = document.createElement('div');
    tempDiv.appendChild(fragment);

    var spans = tempDiv.querySelectorAll('span');
    for (var i = 0; i < spans.length; i++) {
      var span     = spans[i];
      var textNode = document.createTextNode(span.textContent);
      span.parentNode.replaceChild(textNode, span);
    }

    range.deleteContents();
    range.insertNode(tempDiv);

    range.setStartAfter(tempDiv);
    range.collapse(true);
    sel.removeAllRanges();
    sel.addRange(range);
  }

  function alignEditor(editorId, alignment) {
    var el = document.getElementById(editorId);
    if (!el) return;
    el.focus();
    document.execCommand('justify' + alignment, false, null);
  }

  // -------------------------------------------------------------------
