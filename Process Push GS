/**
 * Diagnostic tool: verifies sheet access and logs Email Templates rows.
 * Run manually from the GAS editor -- select this function in the top
 * dropdown and click Run. Check Execution Log for output.
 */
function debugMaintenanceRow() {
  var id = PropertiesService.getScriptProperties().getProperty('CommGenGSheetID');
  Logger.log('Spreadsheet ID: [' + id + ']');
  if (!id) {
    Logger.log('ERROR: CommGenGSheetID Script Property is not set.');
    return;
  }
  var ss         = SpreadsheetApp.openById(id);
  var sheetNames = ss.getSheets().map(function(s) { return s.getName(); });
  Logger.log('Sheet tabs: ' + JSON.stringify(sheetNames));

  var sheet = ss.getSheetByName('Email Templates');
  if (!sheet) {
    Logger.log('Email Templates tab NOT FOUND.');
    return;
  }
  var data = sheet.getDataRange().getValues();
  Logger.log('Total rows: ' + data.length);
  for (var i = 0; i < data.length; i++) {
    Logger.log('Row ' + i + ' | A:[' + data[i][0] + '] C:[' + data[i][2] + '] D:[' + data[i][3] + ']');
  }
}
