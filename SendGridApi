// ===========================================================================
// SENDGRID HELPER: SENDER RESOLUTION
// ===========================================================================

/**
 * Resolves the numeric sender profile ID from SendGrid's verified senders list.
 * Required by the Single-Send API payload (sender_id field).
 *
 * @param {string} apiKey       SendGrid API key.
 * @param {string} senderEmail  Sender email address to look up.
 * @return {number|null} Verified sender ID, or null if not found.
 */
function getSenderIdByEmail(apiKey, senderEmail) {
  try {
    var url = "https://api.sendgrid.com/v3/verified_senders";
    var options = {
      method:             "get",
      headers:            { Authorization: "Bearer " + apiKey, "Content-Type": "application/json" },
      muteHttpExceptions: true
    };
    var response = UrlFetchApp.fetch(url, options);
    if (response.getResponseCode() !== 200) return null;

    var sendersData = JSON.parse(response.getContentText());
    var sendersList = Array.isArray(sendersData)
      ? sendersData
      : (sendersData.results || []);

    var cleanTarget = String(senderEmail).toLowerCase().trim();
    for (var s = 0; s < sendersList.length; s++) {
      if (String(sendersList[s].from_email).toLowerCase().trim() === cleanTarget) {
        return sendersList[s].id;
      }
    }
    return null;

  } catch (e) {
    Logger.log("getSenderIdByEmail error: " + e.toString());
    return null;
  }
}


// ===========================================================================
// SENDGRID HELPER: SEGMENT RESOLUTION
// ===========================================================================

/**
 * Resolves SendGrid Segment IDs from a set of segment name strings.
 * Column L ("SendGrid Segment") contains human-readable segment names.
 * The Single-Send API requires segment IDs in send_to.segment_ids, not names.
 * Segments are fetched from /v3/marketing/segments and matched by name.
 *
 * @param {string}        apiKey        SendGrid API key.
 * @param {Array<string>} segmentNames  Array of segment name strings from Column L.
 * @return {Array<string>} Array of matched SendGrid segment ID strings.
 *                         Empty array if none matched or API call fails.
 */
function getSegmentIdsByName(apiKey, segmentNames) {
  try {
    if (!segmentNames || segmentNames.length === 0) return [];

    var url = "https://api.sendgrid.com/v3/marketing/segments?page_size=100";
    var options = {
      method:             "get",
      headers:            { Authorization: "Bearer " + apiKey, "Content-Type": "application/json" },
      muteHttpExceptions: true
    };
    var response = UrlFetchApp.fetch(url, options);
    if (response.getResponseCode() !== 200) {
      Logger.log("[getSegmentIdsByName] SendGrid segments API returned HTTP " + response.getResponseCode());
      return [];
    }

    var responseData = JSON.parse(response.getContentText());
    var allSegments  = responseData.results || responseData.result || [];

    Logger.log("[getSegmentIdsByName] Total segments returned by API: " + allSegments.length);

    // Build a lowercase name -> id map for O(1) matching.
    var nameToId = {};
    for (var i = 0; i < allSegments.length; i++) {
      var segName = String(allSegments[i].name || "").toLowerCase().trim();
      if (segName) nameToId[segName] = String(allSegments[i].id);
    }

    var resolvedIds  = [];
    var unmatchedLog = [];
    for (var j = 0; j < segmentNames.length; j++) {
      var searchName = String(segmentNames[j]).toLowerCase().trim();
      if (nameToId[searchName]) {
        resolvedIds.push(nameToId[searchName]);
      } else {
        unmatchedLog.push(segmentNames[j]);
      }
    }

    if (unmatchedLog.length > 0) {
      Logger.log("[getSegmentIdsByName] No segment match found for: " + JSON.stringify(unmatchedLog));
    }
    Logger.log("[getSegmentIdsByName] Resolved " + resolvedIds.length + " segment ID(s) from " + segmentNames.length + " name(s).");
    return resolvedIds;

  } catch (e) {
    Logger.log("[getSegmentIdsByName] Error: " + e.toString());
    return [];
  }
}


