// SENDGRID API DISPATCH
// ===========================================================================

/**
 * Creates a SendGrid Single-Send campaign draft from the form payload.
 * The draft is NOT published or sent -- it lands in SendGrid's Campaigns UI
 * for final review and scheduling.
 *
 * SUBJECT ASSEMBLY NOTE:
 *   The client (Index.html evaluateReleaseTypeContext / inputVersionOverride)
 *   is the single owner of subject assembly including the version suffix.
 *   formData.subjectLine arrives fully assembled -- no further appending here.
 *
 * RECIPIENTS NOTE:
 *   formData.selectedPodGroups contains Column L segment name strings from
 *   checked PODs. Null / "Unmapped" PODs are excluded client-side before
 *   the payload is built. getSegmentIdsByName() resolves names to IDs.
 *
 * @param {Object} formData  Full form payload from the client submitData() call.
 * @return {Object} status response object.
 */
function processPushRequest(formData) {
  try {
    if (!formData) formData = {};
    var scriptProperties = PropertiesService.getScriptProperties();
    var SENDGRID_API_KEY  = scriptProperties.getProperty('SendGridAPIKeyID');
    if (!SENDGRID_API_KEY) {
      throw new Error("SendGrid API Key (SendGridAPIKeyID) is missing from Script Properties.");
    }

    var rawVersion       = formData.version || "26R1.0.22";
    var cleanReleaseType = formData.releaseType || "Maintenance Only";
    var defaultSubject   = (cleanReleaseType === "Downtime Required")
      ? "Veeva Release Notification"
      : "Veeva Vault Maintenance Release Notification";

    // Client owns subject assembly -- use formData.subjectLine as-is.
    var compiledSubjectFinal = (formData.subjectLine || defaultSubject).trim();

    var cleanEmailTitle = (formData.emailTitle || compiledSubjectFinal).trim();
    var cleanFromSender = formData.fromSender  || "no-reply@vault.veeva.com";

    var targetSenderId = getSenderIdByEmail(SENDGRID_API_KEY, cleanFromSender);

    // Resolve Column L segment names to SendGrid segment IDs.
    // selectedPodGroups is built client-side from checked PODs whose Column L
    // ("SendGrid Segment") value is non-null and not "Unmapped".
    // getSegmentIdsByName fetches all SendGrid segments and matches by name.
    var selectedSegmentNames = (formData.selectedPodGroups && formData.selectedPodGroups.length > 0)
      ? formData.selectedPodGroups
      : [];
    var resolvedSegmentIds = getSegmentIdsByName(SENDGRID_API_KEY, selectedSegmentNames);

    if (resolvedSegmentIds.length === 0) {
      Logger.log("[processPushRequest] WARNING: No SendGrid segment IDs resolved. Draft will have no recipients.");
    }

    // Campaign name (internal draft label in SendGrid UI, not shown to recipients)
    // appends rawVersion to keep drafts uniquely identifiable in the dashboard.
    var compiledTitleWithVersion = cleanEmailTitle + " - " + rawVersion.trim();

    var finalHtmlBody = generateMasterHtmlLayout(formData);

    var payload = {
      name: compiledTitleWithVersion,
      send_to: {
        segment_ids: resolvedSegmentIds
      },
      email_config: {
        subject:                compiledSubjectFinal,
        html_content:           finalHtmlBody,
        generate_plain_content: true,
        custom_unsubscribe_url: "https://platform.veevavault.help/en/lr/7239/#notification-email",
        sender_id:              targetSenderId,
        tracking_settings: {
          open_tracking:  { enable: false },
          click_tracking: { enable: false }
        }
      }
    };

    var options = {
      method:             "post",
      headers:            { Authorization: "Bearer " + SENDGRID_API_KEY, "Content-Type": "application/json" },
      payload:            JSON.stringify(payload),
      muteHttpExceptions: true
    };

    var response     = UrlFetchApp.fetch("https://api.sendgrid.com/v3/marketing/singlesends", options);
    var responseCode = response.getResponseCode();

    if (responseCode >= 400) {
      return {
        status:  'error',
        message: "SendGrid Refused Payload (HTTP " + responseCode + "): " + response.getContentText()
      };
    }
    return { status: 'success' };

  } catch (err) {
    Logger.log(err.stack);
    return { status: 'error', message: err.message };
  }
}
