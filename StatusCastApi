// STATUSCAST API DISPATCH
// ===========================================================================

/**
 * Creates a StatusCast Trust incident draft from the form payload.
 * The incident is NOT published (isPublished: false) -- it lands in StatusCast
 * as a draft for final review before publishing.
 *
 * COMPONENT ID RESOLUTION:
 *   The client passes podMetadata in formData.podMetadata, populated from
 *   the initial fetchPodDataFromSheet() load. This eliminates the redundant
 *   Sheets API read on every Trust submission. A defensive fallback to
 *   fetchPodDataFromSheet() is kept for older client payload versions.
 *
 * GROUP ID RESOLUTION:
 *   Three stable StatusCast subscriber group IDs are stored in Script Properties:
 *     StatusCastGroupUS -> Vault-US PODs (always included)
 *     StatusCastGroupEU -> Vault-EU PODs (included when EU PODs present)
 *     StatusCastGroupAP -> Vault-AP PODs (included when APAC PODs present)
 *
 * INCIDENT TYPES:
 *   Maintenance       -> ScheduledMaintenance, window anchored +24h to +28h from now.
 *   Unavailable       -> ServiceUnavailable, Investigating post.
 *   Performance Deg.  -> ServiceUnavailable + DegradedPerformance status.
 *   Informational     -> Informational type and post.
 *
 * @param {Object} formData  Full form payload from the client submitData() call.
 * @return {Object} status response object.
 */
function processTrustPushRequest(formData) {
  try {
    if (!formData) formData = {};
    var scriptProperties = PropertiesService.getScriptProperties();

    var rawApiKey  = scriptProperties.getProperty('StatusCastProdTrustAPIKey');
    var fullDomain = scriptProperties.getProperty('StatusCastPageID');
    if (!rawApiKey || !fullDomain) {
      throw new Error("StatusCastProdTrustAPIKey or StatusCastPageID missing from Script Properties.");
    }

    // Falls back to empty string if property not yet set -- does not block execution.
    var assignedUserEmail = scriptProperties.getProperty('StatusCastAssignedEmail') || "";

    var apiKey             = String(rawApiKey).trim();
    var authorizationValue = (apiKey.toLowerCase().indexOf("bearer ") === 0)
      ? apiKey
      : "Bearer " + apiKey;

    // -- Step 1: Fetch active component list for ID validation ---------------
    var componentsUrl = "https://" + String(fullDomain).trim() + "/api/v4/components";
    var componentsResponse = UrlFetchApp.fetch(componentsUrl, {
      method:             "get",
      headers:            { Authorization: authorizationValue, accept: "application/json" },
      muteHttpExceptions: true
    });
    if (componentsResponse.getResponseCode() !== 200) {
      throw new Error("Failed to authenticate or fetch component map from StatusCast API.");
    }

    var activeComponentsData = JSON.parse(componentsResponse.getContentText());
    var validStatusCastIds   = {};
    if (Array.isArray(activeComponentsData)) {
      for (var ci = 0; ci < activeComponentsData.length; ci++) {
        if (activeComponentsData[ci].id) {
          validStatusCastIds[Number(activeComponentsData[ci].id)] = true;
        }
      }
    }

    // -- Step 2: Resolve component IDs from affected PODs text ---------------
    // Use podMetadata passed from client payload where available.
    // Fallback to a fresh Sheets read only if payload is missing podMetadata
    // (supports older client versions during the transition period).
    var metadataSource = null;
    if (formData.podMetadata && typeof formData.podMetadata === 'object') {
      metadataSource = formData.podMetadata;
      Logger.log("[TRUST] Using podMetadata from client payload (no Sheets read required).");
    } else {
      Logger.log("[TRUST] podMetadata not in payload -- falling back to fetchPodDataFromSheet().");
      var sheetData = fetchPodDataFromSheet();
      if (sheetData && sheetData.status === 'success' && sheetData.podMetadata) {
        metadataSource = sheetData.podMetadata;
      }
    }

    var realComponentIds    = [];
    var droppedComponentLog = [];
    var affectedPodsText    = formData.affectedPods || "";

    if (metadataSource) {
      var cleanTextAreaContent = affectedPodsText
        .replace(/<\/?[^>]+(>|$)/g, " ")
        .replace(/[\r\n]+/g, " ")
        .trim();

      var podKeys = Object.keys(metadataSource);
      for (var pk = 0; pk < podKeys.length; pk++) {
        var podKey   = podKeys[pk];
        var metadata = metadataSource[podKey];

        if (!metadata.trustId
            || metadata.trustId.trim() === ""
            || metadata.trustId.trim().toUpperCase() === "#N/A"
            || metadata.trustId.trim().toUpperCase() === "NAN") {
          continue;
        }

        var escapedKey  = podKey.replace(/[-\/\\^$*+?.()|[\]{}]/g, '\\$&');
        var strictRegex = new RegExp("\\b" + escapedKey + "\\b", "i");

        if (strictRegex.test(cleanTextAreaContent)) {
          var numericId = Number(metadata.trustId.trim());
          if (!isNaN(numericId)) {
            if (validStatusCastIds[numericId]) {
              if (realComponentIds.indexOf(numericId) === -1) {
                realComponentIds.push(numericId);
              }
            } else {
              droppedComponentLog.push("'" + podKey + "' (ID: " + numericId + ")");
            }
          }
        }
      }
    }

    if (realComponentIds.length === 0) {
      return {
        status:  'error',
        message: "Aborted: No active StatusCast component IDs found for the selected PODs."
      };
    }

    if (droppedComponentLog.length > 0) {
      Logger.log("[TRUST] Filtered out inactive StatusCast IDs: " + JSON.stringify(droppedComponentLog));
    }

    // -- Step 3: Build incident metadata -------------------------------------
    var now            = new Date();
    var currentIsoDate = now.toISOString();

    var rawVersion       = formData.version || "26R1.0.22";
    var statusType       = formData.statusCastType || "Maintenance";
    var cleanReleaseType = formData.releaseType || "Maintenance Only";
    var cleanProduct     = (formData.product && String(formData.product).trim() !== "")
      ? String(formData.product).trim()
      : "Vault";
    var defaultSubject   = (cleanReleaseType === "Downtime Required")
      ? "Veeva Release Notification"
      : ("Veeva " + cleanProduct + " Maintenance Release Notification");

    var baseTitle   = formData.emailTitle  || defaultSubject;
    var baseSubject = formData.subjectLine || defaultSubject;

    // Title: clean label only, no shortTag prefix, no timestamp suffix.
    // Subject: use the assembled subjectLine from the client as-is.
    var uniqueTitle       = baseTitle.trim() + " - " + rawVersion;
    var customSubjectLine = baseSubject.trim();

    // -- Step 4: Render HTML body for the incident post ----------------------
    // trustMode: true suppresses banners and footer verbiage in the renderer.
    var trustFormData = {};
    for (var k in formData) { if (formData.hasOwnProperty(k)) trustFormData[k] = formData[k]; }
    trustFormData.trustMode = true;
    trustFormData.templateKey = formData.releaseType || formData.templateKey || "";  
    var structuredEmailHtmlMessage = generateMasterHtmlLayout(trustFormData);

    // -- Step 5: Resolve affected groups from region detection ---------------
    // Group IDs are stable and stored in Script Properties.
    // US group is always included. EU and AP are included only when their
    // region label appears in the compiled affectedPods text.
    var groupIdUS = scriptProperties.getProperty('StatusCastGroupUS');
    var groupIdEU = scriptProperties.getProperty('StatusCastGroupEU');
    var groupIdAP = scriptProperties.getProperty('StatusCastGroupAP');

    var cleanPodsForRegion = affectedPodsText
      .replace(/<\/?[^>]+(>|$)/g, " ")
      .replace(/[\r\n]+/g, " ")
      .trim();

 var resolvedGroupIds = [];

 if (groupIdUS) {
      resolvedGroupIds.push(parseInt(groupIdUS, 10));
    }
    if (groupIdEU && /\bEU\b/i.test(cleanPodsForRegion)) {
      resolvedGroupIds.push(parseInt(groupIdEU, 10));
    }
    if (groupIdAP && /\bAPAC\b/i.test(cleanPodsForRegion)) {
      resolvedGroupIds.push(parseInt(groupIdAP, 10));
    }
    
   Logger.log("[TRUST] Resolved affectedGroups (typeof first): " + typeof resolvedGroupIds[0] + " | value: " + resolvedGroupIds[0]);
    Logger.log("[TRUST] Resolved affectedGroups JSON: " + JSON.stringify(resolvedGroupIds));
    
    // -- Step 6: Build incident payload --------------------------------------
    var incidentPayload = {
      title:              uniqueTitle,
      subject:            customSubjectLine,
      isPublished:        false,
      treatAsDowntime:    false,
      sendNotifications:  false,
      externalId:         "",
      affectedComponents: realComponentIds,
      affectedGroups:     resolvedGroupIds,
      customFields:       [],
      posts: [{
        text:        structuredEmailHtmlMessage,
        date:        currentIsoDate,
        isPublished: false,
        postType:    "Informational"
      }]
    };

    // Apply type-specific overrides.
    if (statusType === "Unavailable") {
      incidentPayload.incidentType       = "ServiceUnavailable";
      incidentPayload.newComponentStatus = "Unavailable";
      incidentPayload.posts[0].postType  = "Investigating";

    } else if (statusType === "Performance Degraded" || statusType === "Performance Degradation") {
      incidentPayload.incidentType       = "ServiceUnavailable";
      incidentPayload.newComponentStatus = "DegradedPerformance";
      incidentPayload.posts[0].postType  = "Investigating";

    } else if (statusType === "Maintenance") {
      // Maintenance window anchored +24h to +28h from now.
      var startWindow = new Date(now.getTime() + (24 * 60 * 60 * 1000));
      var endWindow   = new Date(now.getTime() + (28 * 60 * 60 * 1000));

      incidentPayload.incidentType             = "ScheduledMaintenance";
      incidentPayload.newComponentStatus       = "Maintenance";
      incidentPayload.startDate                = startWindow.toISOString();
      incidentPayload.endDate                  = endWindow.toISOString();
      incidentPayload.assignedUserEmail        = assignedUserEmail;
      incidentPayload.scheduledMaintenance     = {
        estimatedDurationMinutes: 240,
        autoClose:  false,
        reminders:  [
          { amount: 4, unit: "Hours" },
          { amount: 2, unit: "Days"  }
        ]
      };
      incidentPayload.posts[0].postType = "Informational";

    } else {
      // Informational
      incidentPayload.incidentType       = "Informational";
      incidentPayload.newComponentStatus = "Informational";
      incidentPayload.posts[0].postType  = "Informational";
    }

    // -- Step 7: Submit to StatusCast API ------------------------------------
    var incidentUrl     = "https://" + String(fullDomain).trim() + "/api/v4/incident";
    var incidentOptions = {
      method:             "post",
      contentType:        "application/json",
      headers:            { Authorization: authorizationValue, accept: "application/json" },
      payload:            JSON.stringify(incidentPayload),
      muteHttpExceptions: true
    };

    var response     = UrlFetchApp.fetch(incidentUrl, incidentOptions);
    var responseCode = response.getResponseCode();
    Logger.log("[TRUST] StatusCast response HTTP " + responseCode + ": " + response.getContentText().substring(0, 500));

    if (responseCode >= 400) {
      return {
        status:  'error',
        message: "StatusCast Server Rejection (HTTP " + responseCode + "): " + response.getContentText()
      };
    }
    return { status: 'success' };

  } catch (err) {
    Logger.log(err.stack);
    return { status: 'error', message: err.message };
  }
}
